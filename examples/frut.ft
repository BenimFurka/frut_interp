// Frut Language Demonstration
// This file showcases all the features of the Frut programming language

// 0. Importing modules
import std.io.*;

// 1. Variable declarations with different types
var greeting: string = "Hello, World!";
var age: int = 25;
var test_pi: double = 3.14159;
var is_student: bool = true;
var temperature: double = 23.5;

// 2. Function definitions with parameters and return types
func calculate_area(width: double, height: double): double {
    return width * height;
}

func factorial(n: int): int {
    if n <= 1 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

func is_even(num: int): bool {
    return num % 2 == 0;
}

// 3. Main program logic
var area: double = calculate_area(10.5, 8.2);
var fact_5: int = factorial(5);
var even_check: bool = is_even(42);

// 4. Conditional statements with if-elif-else
if age < 18 {
    println("You are a minor");
} elif age >= 18 && age < 65 {
    println("You are an adult");

    if is_student {
        println("You are a student");
    }
} else {
    println("You are a senior citizen");
}

// 5. More complex conditional logic
if temperature > 30.0 {
    println("It's hot outside!");
} elif temperature < 10.0 {
    println("It's cold outside!");
} else {
    println("The weather is pleasant");
}

// 6. Function calls and variable usage
println("Greeting: ${greeting}");
println("Age: ${age}");
println("Pi value: ${test_pi}");
println("Is student: ${is_student}");
println("Temperature: ${temperature}");
println("Rectangle area: ${area}");
println("Factorial of 5: ${fact_5}");
println("Is 42 even? ${even_check}");

// 7. Boolean expressions and comparisons
var is_adult: bool = age >= 18;
var is_teenager: bool = age >= 13 && age <= 19;
var can_vote: bool = age >= 18 && is_student == false;

println("Is adult: ${is_adult}");
println("Is teenager: ${is_teenager}");
println("Can vote: ${can_vote}");

// 8. Arithmetic operations
var doubled_age: int = age * 2;
var half_pi: double = test_pi / 2.0;
var temp_minus_pi: double = temperature - test_pi;
var greeting_age: string = greeting + age;

// Error: Type mismatch
// var age_plus_temp: double = age + temperature;

println("Doubled age: ${doubled_age}");
println("Half pi: ${half_pi}");
println("Temperature - Pi: ${temp_minus_pi}");
println("Greeting + age: ${greeting_age}");

// 9. While loop with counter
var counter: int = 0;
while counter < 5 {
    println("Iteration: ${counter}");
    counter = counter + 1;
}

// 10. Type cast
var int_pi: int = test_pi as int;
println("Pi as int: ${int_pi}");

// 11. Input (interactive - commented out to keep the demo non-blocking)
// var name: string = input("Enter your name: ");
// println("Hello, ${name}!");

// 12. Types
type Example {
    x: int;
    y: int;
}

// 13. Extension for types
ext Example {
    func display(self: Example) {
        println("Example { x: ${self.x}, y: ${self.y} }");
    }

    func create(x: int, y: int): Example {
        return Example { x, y };
    }
}

// 14. Creating and using variables with a custom type
var example: Example = Example.create(1, 2);
example.display();

var example2: Example = Example { x: 3, y: 4 };
example2.display();

println("example.x = ${example.x}");
println("example2.y = ${example2.y}");

// 15. Std modules
import std.math.*;

println("min(3, 5) = ${min(3, 5)}");
println("max(3, 5) = ${max(3, 5)}");
println("abs(-7) = ${abs(-7)}");

// 16. Methods for primitive types
var name: string = "Frut";
println("Length of your name is ${name.len()}");

if "Frut".contains("ru") {
    println("Frut contains ru");
}

println("true is ${true.to_int()}")

// 17. Interpolation
var xa: int = 42;
var ya: double = 3.5;
var sa: string = "hello";
var ba: bool = true;

println("xa = ${xa}");
println("ya = ${ya}");
println("sa.len = ${sa.len()}");
println("abs = ${(-5).abs()} ${(-3.14).abs()}");
println("mix = ${sa} ${xa} ${ya} ${ba}");

// Escaping
println("escaped: \${not} and plain ${1+2}");

// Expressions
println("expr = ${xa + 1}");

// 18. Enums (unit variants and payload variants)
enum Color {
    Red,
    Green,
    Blue,
}

enum Shape {
    Circle(double),
    Rect(double, double),
}

var fav_color: Color = Color.Green;
println("fav is Green: ${fav_color.is_Green()}");

var my_shape: Shape = Shape.Circle(2.5);
if my_shape.is_Circle() {
    println("circle radius: ${my_shape.payload()[0]}");
} else {
    println("rect: ${my_shape.payload()[0]}x${my_shape.payload()[1]}");
}

// 19. Enum comparison
var c1: Color = Color.Red;
var c2: Color = Color.Red;
println("c1 == c2: ${c1 == c2}");

// 20. Fixed-length arrays
var fib: [int; 5] = [0, 1, 1, 2, 3];
println("fib[0] = ${fib[0]}, fib[4] = ${fib[4]}");
println("fib.len() = ${fib.len()}");

fib[4] = 5;
println("after write, fib[4] = ${fib[4]}");

var pair: [string; 2] = ["Hello", "Frut"];
println("${pair[0]}, ${pair[1]}!");

// 21. Generics
func identity<T>(x: T): T {
    return x;
}

var gi: int = identity(100);
var gs: string = identity("generics");
println("identity(100) = ${gi}, identity(generics) = ${gs}");

type Box<T> {
    value: T;
}

var box: Box<int> = Box { value: 7 };
println("box.value = ${box.value}");

// 22. Interfaces
interface Figure {
    func area(self): double;
    func perimeter(self): double;
}

type Rect {
    w: double;
    h: double;
}

type Circle {
    r: double;
}

ext Rect : Figure {
    func area(self: Rect): double {
        return self.w * self.h;
    }
    func perimeter(self: Rect): double {
        return 2.0 * (self.w + self.h);
    }
}

ext Circle : Figure {
    func area(self: Circle): double {
        return 3.14159 * self.r * self.r;
    }
    func perimeter(self: Circle): double {
        return 2.0 * 3.14159 * self.r;
    }
}
// Polymorphic function: accepts any type that implements Figure
func describe(s: Figure): string {
    return "area=${s.area()}, perimeter=${s.perimeter()}";
}

var rect: Rect = Rect { w: 2.0, h: 3.0 };
var circle: Circle = Circle { r: 1.0 };
println(describe(rect));
println(describe(circle));

// A heterogeneous array of an interface type
var shapes: [Figure; 2] = [rect, circle];
var total_area: double = 0.0;
var si: int = 0;
while si < shapes.len() {
    total_area = total_area + shapes[si].area();
    si = si + 1;
}
println("total area = ${total_area}");
