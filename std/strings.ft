// Byte-indexed string utilities
import std.native.strings.native_str_len;
import std.native.strings.native_str_char_at;
import std.native.strings.native_str_char_code;
import std.native.strings.native_str_substring;
import std.native.strings.native_str_from_code;
import std.native.strings.native_str_index_of;

// Length in bytes
func len(s: string): int {
    return native_str_len(s);
}

// String identity / normalisation
func str(v: string): string {
    return v;
}

// One-byte substring at `i`
func char_at(s: string, i: int): string {
    return native_str_char_at(s, i);
}

// Byte value at `i`
func char_code(s: string, i: int): int {
    return native_str_char_code(s, i);
}

// Bytes in `[start, end)`
func substring(s: string, start: int, end: int): string {
    return native_str_substring(s, start, end);
}

// One-byte string from a code
func str_from_code(code: int): string {
    return native_str_from_code(code);
}

// First position of `sub`, or -1
func index_of(s: string, sub: string): int {
    return native_str_index_of(s, sub);
}

// Decimal form, including a leading `-`
func int_str(v: int): string {
    if v == 0 {
        return "0";
    }
    var neg: bool = false;
    if v < 0 {
        neg = true;
        v = 0 - v;
    }
    var out: string = "";
    while v > 0 {
        out = str_from_code(48 + v % 10) + out;
        v = v / 10;
    }
    if neg {
        return "-" + out;
    }
    return out;
}

// Leading `+`/`-`, stops at the first non-digit; 0 if no digits
func parse_int(s: string): int {
    var i: int = 0;
    var sign: int = 1;
    var digits: int = 0;
    if i < len(s) {
        if char_code(s, i) == 45 {
            sign = -1;
            i = i + 1;
        } else {
            if char_code(s, i) == 43 {
                i = i + 1;
            }
        }
    }
    var v: int = 0;
    while i < len(s) {
        var c: int = char_code(s, i);
        if c < 48 {
            break;
        }
        if c > 57 {
            break;
        }
        v = v * 10 + (c - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return 0;
    }
    return sign * v;
}

// Byte-prefix test
func starts_with(s: string, prefix: string): bool {
    if len(s) < len(prefix) {
        return false;
    }
    return substring(s, 0, len(prefix)) == prefix;
}

// Byte-suffix test
func ends_with(s: string, suffix: string): bool {
    var n: int = len(suffix);
    if len(s) < n {
        return false;
    }
    return substring(s, len(s) - n, len(s)) == suffix;
}

// Strips leading/trailing spaces, tabs, CR, LF
func trim(s: string): string {
    var start: int = 0;
    var stop: int = len(s);
    while start < stop {
        if !is_space(char_code(s, start)) {
            break;
        }
        start = start + 1;
    }
    while stop > start {
        if !is_space(char_code(s, stop - 1)) {
            break;
        }
        stop = stop - 1;
    }
    return substring(s, start, stop);
}

// True for space, tab, CR, LF
func is_space(c: int): bool {
    if c == 32 {
        return true;
    }
    if c == 9 {
        return true;
    }
    if c == 10 {
        return true;
    }
    if c == 13 {
        return true;
    }
    return false;
}
